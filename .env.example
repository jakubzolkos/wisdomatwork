# Copy to .env.local and fill in. See README.md "Local setup" for details.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email via Resend (required for invites, login codes, notifications) ----
RESEND_API_KEY=
# Optional. Defaults to "WaW Fellows Portal <onboarding@resend.dev>".
EMAIL_FROM="WaW Fellows Portal <no-reply@example.com>"

# --- URLs --------------------------------------------------------------------
# Base for absolute links in emails. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base for poll-voting links in scheduling emails. Falls back to https://leadership.app if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron (required in production) ------------------------------------------
# Bearer token Vercel Cron sends to /api/cron/notifications/dispatch.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Vercel Blob (optional) --------------------------------------------------
# Only needed for school logo uploads.
BLOB_READ_WRITE_TOKEN=
